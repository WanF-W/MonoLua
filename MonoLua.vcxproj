  <!--
    Lua 与 MinHook 作为原样引入的第三方源码，在 MSVC /W4 和 LTCG 下会
    产生其上游已知的窄化、对齐、匿名联合及数据流分析警告。仅对各自目录
    局部屏蔽对应诊断；MonoLua 自有 src 仍保持完整 /W4，不做全局降级。
  -->
  <ItemGroup>
    <ClCompile Update="lua_src\*.c">
      <!-- Lua C++ exceptions preserve C++ bridge destructors across lua_error. -->
      <CompileAs>CompileAsCpp</CompileAs>
      <ForcedIncludeFiles>$(ProjectDir)src\lua_cpp.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <ExceptionHandling>SyncCThrow</ExceptionHandling>
      <!-- Lua bounds hash shifts to fit int before converting their result to size_t. -->
      <DisableSpecificWarnings>4244;4310;4324;4334;4701;4702;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Update="src\*.cpp">
      <!-- 桥接层和 Lua 实现链接在同一个 DLL 中；桥接源文件也必须使用
           Lua API 的导出声明，否则 MSVC 会按 dllimport 处理并为每个 API
           产生 LNK4217/LNK4286。 -->
      <ForcedIncludeFiles>$(ProjectDir)src\lua_cpp.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
    <ClCompile Update="minhook_src\*.c">
      <DisableSpecificWarnings>4201;4206;4244;4310;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemGroup>
